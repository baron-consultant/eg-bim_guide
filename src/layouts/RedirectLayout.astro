---
import { redirectFallbackPrefix as prefixKo, redirectFallbackLinkText as linkKo, redirectFallbackSuffix as suffixKo } from '../lib/sidebarLabels.ko';
import { redirectFallbackPrefix as prefixEn, redirectFallbackLinkText as linkEn, redirectFallbackSuffix as suffixEn } from '../lib/sidebarLabels.en';

const { frontmatter } = Astro.props;
const locale = frontmatter.redirect?.includes('/help/en/') ? 'en' : 'ko';
const prefix = locale === 'en' ? prefixEn : prefixKo;
const linkText = locale === 'en' ? linkEn : linkKo;
const suffix = locale === 'en' ? suffixEn : suffixKo;
---
<!DOCTYPE html>
<html lang={locale}>
<head>
    <meta charset="UTF-8">
    <meta http-equiv="refresh" content={`0;url=${frontmatter.redirect}`}>
    <title>{frontmatter.title}</title>
    <link rel="canonical" href={frontmatter.redirect} />
</head>
<body>
    <h1>{frontmatter.title}</h1>
    <p>{prefix}<a href={frontmatter.redirect}>{linkText}</a>{suffix}</p>
</body>
</html>