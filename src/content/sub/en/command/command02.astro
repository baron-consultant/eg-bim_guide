---
import { IMAGE_BASE_PATH } from '../../config';
---

<section id="group12" class="command02">
<!-- 타이틀 -->
  <div class="page-tit-wrap">
    <div class="tit-box">
      <span class="page-tail"></span>
      <h3>
        Specialized commands frequently used in&nbsp;<span>civil/road drawing work</span>
      </h3>
      <span class="page-tail"></span>
    </div>
    <div class="tip-box">
      <h4 class="tip-tit">How to use</h4>
      <dl>
        <dt>Method 1</dt>
        <dd>
          Command Icon Bar&nbsp;&nbsp;>&nbsp;&nbsp;Command
          View All&nbsp;&nbsp;>&nbsp;&nbsp;Civil/Road
        </dd>
      </dl>
    </div>
  </div>

  <!-- // 타이틀 -->
  <div class="contents">
    <div class="inner">
      <img class="bg-img" src={`${IMAGE_BASE_PATH}/en/command/3x_command_02.png`} alt=" " />
      <!-- 링크 -->
      <div class="blind">
        <dl>
          <dt>EL(Elevation Level)</dt>
          <dd>Calculate EL values needed for drawing work</dd>

          <dt>Draw & Annotate Slopes</dt>
          <dd>Used for drawing front fills of slopes or bridge structures</dd>

          <dt>Road Features & Lane Markings</dt>
          <dd>Used for drawing road facilities such as crosswalks and tapers</dd>

          <dt>Road Features & Lane Markings</dt>
          <dd>Used for drawing road facilities such as crosswalks and tapers</dd>

          <dt>Revise Existing / EL Points</dt>
          <dd>Used to modify and create topographic features like elevation points and contour lines</dd>

          <dt>Horizontal Alignment</dt>
          <dd>Used for planar alignment tasks like creating stations and inquiring alignment stations</dd>

          <dt>Draw & Annotate Slopes</dt>
          <dd>Used for drawing front fills of slopes or bridge structures</dd>

          <dt>Create Cross-Section</dt>
          <dd>Used for drawing cross-sections such as cut and fill slopes</dd>

          <dt>Draw Horizontal Curves</dt>
          <dd>Used to conveniently draw alignments such as transition curves and tangents used in road design</dd>

          <dt>Profile & Elevation</dt>
          <dd>Used for calculating and drawing road profile alignments</dd>

          <dt>Draw Ditch</dt>
          <dd>Create V-shaped gutters and crest gutters</dd>
        </dl>

      </div>
      <!-- // 링크 -->
    </div>
  </div>
</section>