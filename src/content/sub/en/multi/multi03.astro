---
import { IMAGE_BASE_PATH } from "../../config";
---

<section id="group10" class="multi03">
  <!-- 타이틀 -->
  <div class="page-tit-wrap">
    <div class="tit-box">
      <span class="page-tail"></span>
      <h3>
        <span>Simultaneous 2D and 3D work</span>&nbsp; supported by a
        wide-screen &nbsp;<span>3D viewport</span>
      </h3>
      <span class="page-tail"></span>
    </div>
    <div class="tip-box">
      <h4 class="tip-tit">How to use</h4>
      <dl>
        <dt>Method 1</dt>
        <dd>Command Input Window&nbsp;&nbsp;>&nbsp;&nbsp;Command : VPS3D</dd>
      </dl>
      <dl>
        <dt>Method 2</dt>
        <dd>
          Command View All
          &nbsp;&nbsp;>&nbsp;&nbsp;View&nbsp;&nbsp;>&nbsp;&nbsp;<img
            src={`${IMAGE_BASE_PATH}/ico/ico_3d.svg`}
            alt="3d"
          />&nbsp;&nbsp; 3D Viewer&nbsp;&nbsp;>&nbsp;&nbsp;Create 3D Layout
          Viewport
        </dd>
      </dl>
    </div>
  </div>

  <!-- // 타이틀 -->

  <div class="contents">
    <div class="inner">
      <img
        class="bg-img"
        src={`${IMAGE_BASE_PATH}/en/multi/3x_multi_03.png`}
        alt=" "
      />
      <div class="blind">
        <dl>
          <dt>2D Workspace</dt>
          <dd>
            Configure viewport and set view styles using the VPORTS command
          </dd>

          <dt>Dual Mode Simultaneous Work</dt>
          <dd>Simultaneous 2D and 3D work supported by 3D Space</dd>
          <dd>Close 3D Space Window → Return to initial planar view</dd>

          <dt>3D SPACE</dt>
          <dd>
            All functions can be used exactly the same as the existing workspace
          </dd>

          <dt>Set View Direction and Visual Style</dt>
          <dd>Activated only in the selected viewport</dd>

          <dt>Set View Direction and Visual Style</dt>
        </dl>
      </div>
    </div>
  </div>
</section>
