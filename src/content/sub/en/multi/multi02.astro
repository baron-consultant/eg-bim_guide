---
import { IMAGE_BASE_PATH } from '../../config';
---

<section id="group9" class="multi02">
<!-- 타이틀 -->
<div class="page-tit-wrap">
  <div class="tit-box">
    <span class="page-tail"></span>
    <h3>
      <span>Simultaneous work on Model Space and Layout Space</span>&nbsp;by separating&nbsp;
      <span>Layout Tab screen</span>
    </h3>
    <span class="page-tail"></span>
  </div>
  <div class="tip-box">
    <h4 class="tip-tit">How to use</h4>
    <dl>
      <dt>Method 1</dt>
      <dd>Workspace Tab&nbsp;&nbsp;>&nbsp;&nbsp;Drag & Drop Layout</dd>
    </dl>
  </div>
</div>
<!-- // 타이틀 -->

<div class="contents">
  <div class="inner">
    <img class="bg-img" src={`${IMAGE_BASE_PATH}/en/multi/3x_multi_02.png`} alt=" " />
    <div class="blind">
       <dl>
          <dt>Dual Mode Simultaneous Work (Layout Space)</dt>
          <dd>Model Space & Layout Space / Layout Space & Layout Space Simultaneous Work</dd>
          <dd>Drag & Drop outside the screen to create a Layout Space</dd>
 
          <dt>Separate Layout Tab</dt>
          <dd>Layout Tab is separated and Layout Space is created separately</dd>
          <dd>All functions can be used exactly the same as the existing workspace</dd>
        </dl>
    </div>
  </div>
</div>
