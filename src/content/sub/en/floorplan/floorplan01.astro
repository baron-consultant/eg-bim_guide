---
import { IMAGE_BASE_PATH } from '../../config';
---

<section id="group28" class="floorPlan01">
  <!-- 타이틀 -->
  <div class="page-tit-wrap">
    <div class="tit-box">
      <span class="page-tail"></span>
      <h3>
        <span>Explore and browse</span>&nbsp;drawing files within a selected folder&nbsp;<span
          >at a glance and view information</span
        >
      </h3>
      <span class="page-tail"></span>
    </div>
    <div class="tip-box">
      <h4 class="tip-tit">How to use</h4>
      <dl>
        <dt>Method 1</dt>
        <dd>
          Top Bar Right&nbsp;&nbsp;>&nbsp;&nbsp;<img
            src={`${IMAGE_BASE_PATH}/ico/ico_floorplan.svg`}
            alt=""
          />&nbsp;Kkureomi
        </dd>
      </dl>
    </div>
  </div>

  <!-- // 타이틀 -->
  <div class="contents">
    <div class="inner">
      <img class="bg-img" src={`${IMAGE_BASE_PATH}/en/floorplan/3x_floorplan_01.png`} alt=" " />

      <!-- 링크 -->
      <ul>
        <li>
          <a class="link-atrb-block" href="/eg-bim_guide/help/floorplan02">
            <span class="blind">Edit Title Block</span>
             <div class="blind">Modify information such as drawing name, drawing number, etc.</div>
          </a>
        </li>

        <li>
          <a class="link-multi-print" href="/eg-bim_guide/help/multiprint01">
            <span class="blind">Multi Plot</span>
             <div class="blind">Set print options and batch print multiple drawings</div>
          </a>
        </li>

        <li>
          <a class="link-main" href="/eg-bim_guide/help/interface01">
            <span class="blind">Open GURIMI</span>
             <div class="blind">Execute drawing workspace</div>
          </a>
        </li>

        <li class="blind">
          <dl>
            <dt>Custom Folder</dt>

            <dt>Add Custom Folder</dt>
            <dd>Drag & Drop to user-designated folder</dd>

            <dt>Search Folder</dt>

            <dt>Search Drawing</dt>
            <dd>Search for drawings within the selected folder</dd>
            <dd>Keyword search within displayed drawing info such as drawing name, drawing number, etc.</dd>

            <dt>Drawing Info</dt>
            <dd>Providing drawing information based on construction CALS such as file name, drawing name, drawing number, etc.</dd>
            <dd>Open : Displays files currently running in GURIMI</dd>
            <dd>Right-click to execute Move, Copy, Insert, Delete, and Open commands</dd>
            <dd>Double-click to execute corresponding drawing in Grimi</dd>

            <dt>Separate Preview Screen</dt>

            <dt>Adjust Preview Size</dt> 

            <dt>Expand Screen</dt>

            <dt>Preview</dt>
            <dd>Preview drawing files within the selected folder</dd>
            <dd>Open : Displays files currently running in GURIMI</dd>
          </dl>
      </li>
      </ul>
      <!-- // 링크 -->
    </div>
  </div>
</section>