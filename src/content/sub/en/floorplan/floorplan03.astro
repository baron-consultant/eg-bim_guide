<section id="group30" class="floorPlan03">
  <!-- 타이틀 -->
  <div class="page-tit-wrap">
    <div class="tit-box">
      <span class="page-tail"></span>
      <h3>
        <span>Select and display the desired information</span>&nbsp;from various Title Block items.
      </h3>
      <span class="page-tail"></span>
    </div>
    <div class="tip-box">
      <h4 class="tip-tit">How to use</h4>
      <dl>
        <dt>Method 1</dt>
        <dd>
          Kkureomi&nbsp;&nbsp;>&nbsp;&nbsp;Top
          Left&nbsp;&nbsp;>&nbsp;&nbsp;Edit Title Block
        </dd>
      </dl>
    </div>
  </div>

  <!-- // 타이틀 -->
  <div class="contents">
    <div class="inner">
      <img class="bg-img" src={`${IMAGE_BASE_PATH}/en/floorplan/3x_floorplan_03.png`} alt=" " />
    <div class="blind">
          <dl>
            <dt>Select Drawing Info Items</dt>
            <dd>Displays drawing info items present in the title block</dd>
            <dd>Check desired information to edit drawing info items (e.g. Fixed Items, Editable Items)</dd>

            <dt>Display Being-Modified Items in Selection Window</dt>
