---
import { IMAGE_BASE_PATH } from '../../config';
---

<section id="group25" class="block05">
<!-- 타이틀 -->
<div class="page-tit-wrap">
  <div class="tit-box">
    <span class="page-tail"></span>
    <h3>
      <span>Provides various blocks</span>&nbsp;commonly used in the&nbsp;<span
        >construction sector</span
      >, classified by category
    </h3>
    <span class="page-tail"></span>
  </div>
  <div class="tip-box">
    <h4 class="tip-tit">How to use</h4>
    <dl>
      <dt>Method 1</dt>
      <dd>Command Input Window&nbsp;&nbsp;>&nbsp;&nbsp;Command : BLIBRARY</dd>
    </dl>
    <dl>
      <dt>Method 2</dt>
      <dd>
        Command
        View All&nbsp;&nbsp;>&nbsp;&nbsp;Block&nbsp;&nbsp;>&nbsp;&nbsp;<img
          src={`${IMAGE_BASE_PATH}/ico/ico_multi_block.svg`} 
          alt=""
        />&nbsp;&nbsp;Import
        Blocks&nbsp;&nbsp;>&nbsp;&nbsp;Block Library
      </dd>
    </dl>
  </div>
</div>

<!-- // 타이틀 -->
<div class="contents">
  <div class="inner">
   <img class="bg-img" src={`${IMAGE_BASE_PATH}/en/block/3x_block_05.png`} alt=" " />
     <!-- 링크 -->
    <ul>
      <li>
        <a class="link-block" href="/eg-bim_guide/help/en/block01">
          <span class="blind">Block Manager (BLOCK)</span>
          <div class="blind">Execute the integrated block window to create, insert/modify, and manage blocks</div>
        </a>
      </li>
       <li class="blind">
          <dl>
            <dt>Block LIST by Group</dt>
            <dd>Broadly classified into 5 sectors (General Design, Surveying & Ground Investigation, Road, Civil Structure, Water & Sewage)</dd>

            <dt>Select Block</dt>
            <dd>Click to select the desired block</dd>
            <dd>Use SHIFT/CTRL keys for multiple selection and deselection</dd>

            <dt>Preview Selected Block</dt>

            <dt>Apply Selected Block</dt>
            <dd>Registers the selected block to the Integrated Block Window (BLOCK), not inserted on screen</dd>
          </dl>
      </li>
    </ul>
        <!-- // 링크 -->
  </div>
</div>
</section>