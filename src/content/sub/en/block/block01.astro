---
import { IMAGE_BASE_PATH } from '../../config';
---

<section id="group21" class="block01">
<!-- 타이틀 -->
<div class="page-tit-wrap">
  <div class="tit-box">
    <span class="page-tail"></span>
    <h3>
      <span>Create</span>&nbsp;and <span>manage</span>
      &nbsp;<span>blocks/attribute blocks/External Reference (images)</span>&nbsp;<span>comprehensively</span>&nbsp;in the drawing
    </h3>
    <span class="page-tail"></span>
  </div>
  <div class="tip-box">
    <h4 class="tip-tit">How to use</h4>
    <dl>
      <dt>Method 1</dt>
      <dd>Command Input Window&nbsp;&nbsp;>&nbsp;&nbsp;Command : BLOCK</dd>
    </dl>
    <dl>
      <dt>Method 2</dt>
      <dd>
        Command
        View All&nbsp;&nbsp;>&nbsp;&nbsp;Block&nbsp;&nbsp;>&nbsp;&nbsp;<img
          src={`${IMAGE_BASE_PATH}/ico/ico_block.svg`}
          alt=""
        />&nbsp;&nbsp;Create Block&nbsp;&nbsp;>&nbsp;&nbsp;Block Manager
      </dd>
    </dl>
  </div>
</div>

<!-- // 타이틀 -->
<div class="contents">
  <div class="inner">
    <img class="bg-img" src={`${IMAGE_BASE_PATH}/en/block/3x_block_01.png`} alt=" " />
    <!-- 링크 -->
    <ul>
      <li>
        <a class="link-block" href="/eg-bim_guide/help/block02">
          <span class="blind">Block</span>
          <div class="blind">
            When repeating objects, block the repeating objects
            Blocks with the same name are updated entirely when modified
          </div>
        </a>
      </li>

      <li>
        <a class="link-atrbBlock" href="/eg-bim_guide/help/block03">
          <span class="blind">Attribute Block</span>
          <div class="blind">
            A block including attribute texts, allowing individual attribute values even for the same block
          </div>
        </a>
      </li>

      <li>
        <a class="link-ref" href="/eg-bim_guide/help/block04">
          <span class="blind">External Reference</span>
           <div class="blind">
            Link external reference files (DWG, PDF, JPG, etc.) to the current file for use as blocks
            Changes to the external reference file are reflected in the current file
          </div>
        </a>
      </li>
      <li class="blind">
          <dl>
            <dt>Search Block</dt>

            <dt>Block Property Info</dt>
            <dd>Basic property information (preview window, Block Name, Comments, Layer, etc.) and basic block settings like settings upon block insertion and viewport scale settings</dd>

            <dt>Block Unit</dt>
            <dd>Designates the units inserted into the drawing. Commonly applied to blocks, attribute blocks, and External Reference</dd>
          </dl>
      </li>
    </ul>
    <!-- // 링크 -->
  </div>
</div>
</section>