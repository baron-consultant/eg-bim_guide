---
import { IMAGE_BASE_PATH, VIDEO_BASE_PATH } from '../../config';
import VideoModal from '.././../../../components/VideoModal.astro';

const videoModals = [
  { id: 'modal-add', videoSrc: `${VIDEO_BASE_PATH}/video/en/atrbBlock_add.mp4` },
];
---

<section  id="group23" class="block03">
<!-- 타이틀 -->
<div class="page-tit-wrap">
  <div class="tit-box">
    <span class="page-tail"></span>
    <h3>
      Create and&nbsp;<span>manage</span>&nbsp;<span>attribute blocks</span>&nbsp;where&nbsp;
      <span>text contents</span>&nbsp;within the block can be&nbsp;<span>changed</span>&nbsp;and used
    </h3>
    <span class="page-tail"></span>
  </div>
  <div class="tip-box">
    <h4 class="tip-tit">How to use</h4>
    <dl>
      <dt>Method 1</dt>
      <dd>Command Input Window&nbsp;&nbsp;>&nbsp;&nbsp;Command : BLOCK</dd>
    </dl>
    <dl>
      <dt>Method 2</dt>
      <dd>
        Command
        View All&nbsp;&nbsp;>&nbsp;&nbsp;Block&nbsp;&nbsp;>&nbsp;&nbsp;<img
          src={`${IMAGE_BASE_PATH}/ico/ico_block.svg`}
          alt=""
        />&nbsp;&nbsp;Create Block&nbsp;&nbsp;>&nbsp;&nbsp;Block Manager
      </dd>
    </dl>
  </div>
</div>

<!-- // 타이틀 -->
<div class="contents">
  <div class="inner">
    <img class="bg-img" src={`${IMAGE_BASE_PATH}/en/block/3x_block_03.png`} alt=" " />
    <!-- 링크 -->
      <ul>
        <li>
          <button type="button" class="link-add" data-modal="modal-add">
            <span class="blind">Add Attribute Block</span>
            <div class="blind">
              Select attribute text and objects to designate as an attribute block, then specify base point
              * ATTDEF : Create attribute text
            </div>
          </button>
        </li>
        
        <li class="blind">
          <dl>
            <dt>Attribute Block LIST</dt>
            <dd>List of attribute blocks available for use in the current file</dd>
            <dd>Composed of attribute block names and descriptions</dd>

            <dt>Select Attribute Block</dt>
            <dd>Click to set display status</dd>
            <dd>Right-click to delete</dd>

            <dt>Insert Attribute Block</dt>
            <dd>1) Double-click to add to workspace</dd>
            <dd>2) Drag & Drop to workspace</dd>

            <dt>Preview Selected Block</dt>

            <dt>Modify Basic Properties of Selected Attribute Block</dt>
            <dd>Click to modify basic properties of attribute block</dd>
            <dd>Name : Name of the attribute block</dd>
            <dd>Comments : Description of the attribute block</dd>
            <dd>Layer : Layer the attribute block belongs to</dd>
            <dd>Color : Color of the objects making up the attribute block</dd>

            <dt>Settings</dt>
            <dd>Allow Exploding on insertion : Set whether to allow Explode command after insertion</dd>
            <dd>Apply Annotation Scaling : Can adjust scale for block shapes to fit the viewport</dd>
            <dd>Specify Insertion point on screen : Inserts block at 0,0,0 coordinates when unchecked</dd>

            <dt>Set Attribute Values of Attribute Block</dt>
            <dd>Tag : A tag that identifies the attribute</dd>
            <dd>Prompt : Description of the text value content</dd>
            <dd>Text String : The value corresponding to the displayed text content</dd>
            <dd>Click to modify attribute values of the attribute block</dd>

          </dl>
      </li>
      </ul>
      <!-- // 링크 -->
  </div>
</div>

  <!-- 모달들 -->
  {videoModals.map(modal => (
    <VideoModal id={modal.id} videoSrc={modal.videoSrc} />
  ))}
</section>

<script>
  import { initModalController } from '.././../../../lib/modalController';
  
  // 초기 로드
  initModalController();
  
  // Astro 페이지 전환 시에도 재실행
  document.addEventListener('astro:page-load', () => {
    initModalController();
  });
</script>
