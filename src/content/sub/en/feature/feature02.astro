<section id="group19" class="feature02">
<!-- 타이틀 -->
<div class="page-tit-wrap">
  <div class="tit-box">
    <span class="page-tail"></span>
    <h3>
      <span>Select a color</span>&nbsp;to apply and check the&nbsp;
      <span>property</span>&nbsp;values of the selected color
    </h3>
    <span class="page-tail"></span>
  </div>
  <div class="tip-box">
    <h4 class="tip-tit">How to use</h4>
    <dl>
      <dt>Method 1</dt>
      <dd>Command Input Window&nbsp;&nbsp;>&nbsp;&nbsp;Command : COLOR</dd>
    </dl>
    <dl>
      <dt>Method 2</dt>
      <dd>
        Top Bar&nbsp;&nbsp;>&nbsp;&nbsp;Color&nbsp;&nbsp;>&nbsp;&nbsp;Color
        Edit
      </dd>
    </dl>
  </div>
</div>

<!-- // 타이틀 -->
<div class="contents">
  <div class="inner">
    <img class="bg-img" src={`${IMAGE_BASE_PATH}/en/feature/3x_feature_02.png`} alt=" " />
          <div class="blind">
          <dl>
            <dt>Bar</dt>
            <dd>Major property information of the selected object is displayed and can be modified</dd>

            <dt>Popup</dt>

            <dt>Quick Select</dt>
            <dd>Filter selected objects by conditions to select only desired objects</dd>

            <dt>Basic Info</dt>
            <dd>Basic properties shared by all objects</dd>

            <dt>Shape Info</dt>
            <dd>Displays shape information such as size, area, length, and angle according to the type of selected object</dd>

            <dt>Geometry</dt>
            <dd>Displays coordinate information such as start/end points and vertices according to the type of selected object</dd>

            <dt>Multi-Selection</dt>
            <dd>When multiple objects of the same type are selected, displays the object count</dd>
            <dd>When multiple objects of different types are selected, displays as a list * When multiple objects of different types are selected</dd> 
          </dl>
        </div>
  </div>
</div>
</section>