---
import { IMAGE_BASE_PATH } from "../../config";
---

<section id="group2" class="interface02">
  <!-- 타이틀 -->
  <div class="page-tit-wrap">
    <div class="tit-box">
      <span class="page-tail"></span>
      <h3>
        <span>Backup and restore</span>&nbsp;environment values set by the user
      </h3>
      <span class="page-tail"></span>
    </div>
    <div class="tip-box">
      <h4 class="tip-tit">How to use</h4>
      <dl>
        <dt>Method 1</dt>
        <dd>
          Top bar left&nbsp;&nbsp;>&nbsp;&nbsp;EG-BIM
          Logo&nbsp;&nbsp;>&nbsp;&nbsp;Home Menu&nbsp;&nbsp;>&nbsp;&nbsp;User
          Settings
        </dd>
      </dl>
    </div>
  </div>

  <!-- // 타이틀 -->
  <div class="contents">
    <img
      class="bg-img"
      src={`${IMAGE_BASE_PATH}/en/interface/3x_interface_03.png`}
      alt=" "
    />
    <!-- 텍스트 -->
    <div class="blind">
      <dl>
        <dt>Home Menu</dt>
        <dd>When clicked, switches between Basic Properties Menu ↔ Home Menu</dd>

        <dt>User Settings</dt>
        <dd>
          Save Settings : "User settings have been exported." notification pops up
          and saves current environment values (Screen, Mouse, Shortcuts, etc.)
        </dd>
        <dd>
          Load Settings : "User settings have been imported." message pops up and
          loads backed-up user settings
        </dd>
      </dl>
    </div>
    <!-- // 텍스트 -->
  </div>
</section>
