---
import { IMAGE_BASE_PATH } from "../../config";
---

<section id="group1" class="mainview">
  <!-- 타이틀 -->
  <div class="page-tit-wrap">
    <div class="tit-box">
      <h3>
        <span>Efficient screen layout</span>&nbsp;of essential elements & <span
          >spacious workspace</span
        >
      </h3>
    </div>
  </div>

  <!-- // 타이틀 -->
  <div class="contents">
    <div class="inner">
      <img
        class="bg-img"
        src={`${IMAGE_BASE_PATH}/en/interface/3x_interface_01.png`}
        alt=" "
      />
      <!-- 링크 -->
      <ul>
        <li>
          <a class="link-homemenu" href="/eg-bim_guide/help/en/interface02">
            <span class="blind">Home Menu</span>
            <div class="blind">
              Collection of file-related menus such as Open, Save, etc.
            </div>
          </a>
        </li>
        <li class="blind">
          <dl>
            <dt>File Tab</dt>
            <dd>Create New File, Open/Close</dd>
            <dd>Check/Preview the list of opened files</dd>
            <dt>New Drawing (New)</dt>
            <dt>open(Open)</dt>
          </dl>
        </li>
        <li>
          <a class="link-propsbar" href="/eg-bim_guide/help/en/feature01">
            <span class="blind">Property Bar</span>
            <div class="blind">
              Check major property information of the selected object
            </div>
          </a>
        </li>

        <li>
          <a class="link-mainprops" href="/eg-bim_guide/help/en/feature01">
            <span class="blind">Property Popup</span>
            <div class="blind">
              Check all property information of the selected object
            </div>
          </a>
        </li>
        <li class="blind">
          <dl>
            <dt>Basic Properties Menu</dt>
            <dd>
              Draw Mode : Created with property values set when creating an
              object
            </dd>
            <dd>
              Selected Object : Displays and changes properties when an object
              is selected
            </dd>
            <dd>
              Create and manage layers/styles in the detailed properties window
            </dd>
          </dl>
        </li>
        <li>
          <a class="link-layer" href="/eg-bim_guide/help/en/layer01">
            <span class="blind">Open Layer</span>
          </a>
        </li>

        <li>
          <a class="link-color" href="/eg-bim_guide/help/en/feature02">
            <span class="blind">Color Edit</span>
          </a>
        </li>
        <li>
          <a class="link-line" href="/eg-bim_guide/help/en/style01">
            <span class="blind">Line Style Detail</span>
          </a>
        </li>
        <li>
          <a class="link-text" href="/eg-bim_guide/help/en/style02">
            <span class="blind">Text Style Detail</span>
          </a>
        </li>
        <li>
          <a class="link-msmt" href="/eg-bim_guide/help/en/style03">
            <span class="blind">Dimension Style Detail</span>
          </a>
        </li>
        <li>
          <a class="link-print" href="/eg-bim_guide/help/en/print01">
            <span class="blind">Print</span>
          </a>
        </li>

        <li>
          <a class="link-ggurumi" href="/eg-bim_guide/help/en/floorplan01">
            <span class="blind">Kkureomi</span>
          </a>
        </li>

        <li class="blind">
          <dl>
            <dt>Move Window</dt>
            <dd>Move/Zoom In/Zoom Out Window</dd>
          </dl>
        </li>
        <li>
          <a class="link-mainprf" href="/eg-bim_guide/help/en/customize03">
            <span class="blind">Support View All</span>
          </a>
        </li>
        <li>
          <a class="link-setbar" href="/eg-bim_guide/help/en/customize01">
            <span class="blind">Support Icon Bar</span>
            <ul class="blind">
              <li>
                Set auxiliary functions such as Grid and Object Snap (ON/OFF
                mode via icon color)
              </li>
              <li>
                Up to 6 commands can be registered (15 types provided in total)
              </li>
              <li>
                Add icons by Drag & Drop from View All Auxiliary Functions
              </li>
            </ul>
          </a>
        </li>
        <li>
          <a class="link-cmdbar" href="/eg-bim_guide/help/en/customize01">
            <span class="blind">Command Icon Bar</span>
            <div class="blind">
              Execute command by clicking the icon, editable with user-preferred
              commands
            </div>
          </a>
        </li>

        <li class="blind">
          <dl>
            <dt>Command Input Window</dt>
            <dd>
              Enter a command and display the progress of the entered command
            </dd>

            <dt>Command History</dt>
            <dd>Check History from the point the file was opened</dd>
          </dl>
        </li>
        <li>
          <a class="link-cmdall" href="/eg-bim_guide/help/en/command01">
            <span class="blind">Command View All</span>
          </a>
        </li>
        <li class="blind">
          <dl>
            <dt>Workspace Tab</dt>
            <dd>Switch screens between Model Space and Layout Space</dd>

            <dt>Add Command Icon</dt>
            <dd>
              Add icons by Drag & Drop from View All Commands (Max 16 per group)
            </dd>

            <dt>Add Group</dt>
            <dd>
              Add custom user group (in addition to the 12 default groups)
            </dd>
          </dl>
        </li>
      </ul>
      <!-- // 링크 -->
    </div>
  </div>
</section>
