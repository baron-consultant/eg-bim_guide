---
import { IMAGE_BASE_PATH } from "../../config";
---

<section id="group2" class="interface01">
  <!-- 타이틀 -->
  <div class="page-tit-wrap">
    <div class="tit-box">
      <span class="page-tail"></span>
      <h3>
        <span>Basic file-related functions</span>&nbsp;and&nbsp; <span
          >user settings</span
        > &nbsp; functions
      </h3>
      <span class="page-tail"></span>
    </div>
    <div class="tip-box">
      <h4 class="tip-tit">How to use</h4>
      <dl>
        <dt>Method 1</dt>
        <dd>
          Top bar left&nbsp;&nbsp;>&nbsp;&nbsp;EG-BIM
          Logo&nbsp;&nbsp;>&nbsp;&nbsp;Home Menu
        </dd>
      </dl>
    </div>
  </div>

  <!-- // 타이틀 -->
  <div class="contents">
    <div class="inner">
      <img
        class="bg-img"
        src={`${IMAGE_BASE_PATH}/en/interface/3x_interface_02.png`}
        alt=" "
      />
      <!-- 텍스트 -->
      <ul>
        <li class="blind">
          <dl>
            <dt>Home Menu</dt>
            <dd>When clicked, switches between Basic Properties Menu ↔ Home Menu</dd>

            <dt>Activated File</dt>
            <dd>Save : Save currently working contents</dd>
            <dd>Save AS : Save the file as a copy with a different name</dd>
            <dd>
              Export : Export to a different format (PDF, SVG, etc.)<br />
              * Exportable file formats<br />
              Portable Document Format (*.pdf)<br />
              Scalable Vector Graphics (*.svg)<br />
              Bitmap file (*.bmp)<br />
              Windows meta File (*.wmf)<br />
              Enhanced Windows Meta File (*.emf)<br />
              Design Web Format (*.dwf)<br />
              Stereolithography (*.stl)<br />
              COLLAborative Design Activity (*.dae)<br />
              MicroStation Design File (*.dgn)<br />
              Wavefront Object format (*.obj)
            </dd>
            <dd>e-transmit : Bind External Reference files and drawing into a package</dd>

            <dt>Open Files</dt>
            <dd>Open File : Find and open a saved file from PC or network path</dd>
            <dd>Recent Files : Display recently worked files (Max 10)</dd>
            <dd>New File : Create a new file</dd>

            <dt>Opened File</dt>

            <dt>Preview</dt>
            <dd>Check preview by hovering over recent files</dd>

            <dt>Corrupted File</dt>
            <dd>Recover : Recover corrupted drawing files</dd>
            <dd>Temporary : Shortcut to automatically saved temporary files folder</dd>

            <dt>User Settings</dt>
            <dd>Display & Mouse : Display environment and mouse settings</dd>
            <dd>
              Save Settings : Save environment values set by the current user
              (Screen, Mouse, Shortcuts, etc.)
            </dd>
            <dd>Load Settings : Load and apply previously saved user setting values</dd>

            <dt>Explore</dt>
            <dd>View Guide : View the program user guide</dd>
            <dd>Contact Us : Go to the EG-BIM Homepage FAQ</dd>
            <dd>About : Check license and version information</dd>
          </dl>
        </li>
        <li>
          <a class="link-userset" href="/eg-bim_guide/help/en/interface03">
            <span class="blind">Home Menu</span>
            <div class="blind">Collection of file-related menus such as Open, Save, etc.</div>
          </a>
        </li>
        <li class="blind">
          <dl>
            <dt>Explore</dt>
            <dd>View Guide : View the program user guide</dd>
            <dd>Contact Us : Go to the EG-BIM Homepage FAQ</dd>
          </dl>
        </li>
        <li>
          <a class="link-sw" href="/eg-bim_guide/help/en/information">
            <span class="blind">About</span>
            <div class="blind">Check license and version information</div>
          </a>
        </li>
      </ul>
      <!-- // 텍스트 -->
    </div>
  </div>
</section>
