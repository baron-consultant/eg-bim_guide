---
import { IMAGE_BASE_PATH } from '../../config';
---


<section id="group32" class="multiprint02">
<!-- 타이틀 -->
<div class="page-tit-wrap">
  <div class="tit-box">
    <span class="page-tail"></span>
    <h3>
      <span>Set print options</span>&nbsp;for batch printing and preview or print to paper/file
    </h3>
    <span class="page-tail"></span>
  </div>
  <div class="tip-box">
    <h4 class="tip-tit">How to use</h4>
    <dl>
      <dt>Method 1</dt>
      <dd>
        Kkureomi&nbsp;&nbsp;>&nbsp;&nbsp;Top Left&nbsp;&nbsp;>&nbsp;&nbsp;Multi
        Plot
      </dd>
    </dl>
  </div>
</div>

<!-- // 타이틀 -->
<div class="contents">
  <div class="inner">
    <img class="bg-img" src={`${IMAGE_BASE_PATH}/en/multiprint/3x_multiprint_02.png`} alt=" " />
    
    <div class="blind">
      <dl>
        <dt>Plot Device</dt>
        <dd>Printer : Select printer and plotter</dd>
        <dd>File : Select among PDF, JPG, PNG</dd>

        <dt>Paper Size</dt>
        <dd>Select paper orientation</dd>
        <dd>List of printable papers by device</dd>
        <dd>User paper settings</dd>

        <dt>Plot Style</dt>
        <dd>Select and apply Layer Plot Style or Plot Style (CTB)</dd>
        <dd>Changes to Layer Plot Style upon clicking Reset button</dd>

        <dt>Paper Margins</dt>
        <dd>User can click margin values to input modified values, or auto-center to paper by clicking the Center button</dd>

        <dt>Display Print Pages</dt>
        <dd>Generates preview pages for the number of files selected in batch print</dd>

        <dt>Paper Size</dt>
        <dd>Size adjustable only when user paper is 0 x 0(mm)</dd>

        <dt>Print Preview</dt>
        <dd>Press the Refresh button when settings change to apply changes</dd>
      </dl>
    </div>
  </div>
</div>
</section>