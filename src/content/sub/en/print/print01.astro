---
import { IMAGE_BASE_PATH } from '../../config';
---

<section id="group27" class="print01">
<!-- 타이틀 -->
<div class="page-tit-wrap">
  <div class="tit-box">
    <span class="page-tail"></span>
    <h3>
      <span>Set</span>&nbsp;print&nbsp;<span>options</span>&nbsp;for printing and&nbsp;<span>preview</span>
      &nbsp;or&nbsp;<span>print</span>&nbsp;to paper or file
    </h3>
    <span class="page-tail"></span>
  </div>
  <div class="tip-box">
    <h4 class="tip-tit">How to use</h4>
    <dl>
      <dt>Method 1</dt>
      <dd>Command Input Window&nbsp;&nbsp;>&nbsp;&nbsp;Command : PLOT</dd>
    </dl>
    <dl>
      <dt>Method 2</dt>
      <dd>
        Top Bar Right&nbsp;&nbsp;>&nbsp;&nbsp;<img
          src={`${IMAGE_BASE_PATH}/ico/ico_print.svg`}
          alt=""
        />&nbsp;Print Button
      </dd>
    </dl>
  </div>
</div>

<!-- // 타이틀 -->
<div class="contents">
  <div class="inner">
    <img class="bg-img" src={`${IMAGE_BASE_PATH}/en/print/3x_print_01.png`} alt=" " />
    <div class="blind">
          <dl>
            <dt>Page Setup</dt>
            <dd>Use pre-designated page setup values or previous plot values</dd>

            <dt>Plot Device</dt>
            <dd>Printer : Select printer and plotter</dd>
            <dd>File : Select among PDF, JPG, PNG</dd>

            <dt>Paper Size</dt>
            <dd>Select paper orientation</dd>
            <dd>List of printable papers by device</dd>
            <dd>User paper settings</dd>

            <dt>Print Range</dt>
            <dd>Select Frame : Auto-recognize title block area</dd>
            <dd>User Frame : Add custom title block</dd>
            <dd>User Area : Specify desired area</dd>
            <dd>All Entities : Area including all objects</dd>
            <dd>All : Print all title blocks</dd>
            <dd>Fit : Fit to paper and input scale</dd>

            <dt>Plot Style</dt>
            <dd>Select and apply Layer Plot Style or Plot Style (CTB)</dd>
            <dd>Changes to Layer Plot Style upon clicking Reset button</dd>

            <dt>Real Time Plot Preview</dt>
            <dd>Whether to use real-time preview for changes upon modifying print settings</dd>

            <dt>Paper Margins</dt>
            <dd>User can click margin values to input modified values, or auto-center to paper by clicking the Center button</dd>

            <dt>Display Print Pages</dt>
            <dd>Displays number of pages when Fit to Title Block is selected for Print Area and Print All is checked</dd>

            <dt>Paper Size</dt>
            <dd>Size adjustable only when user paper is 0 x 0(mm)</dd>
          </dl>
      </div>
  </div>
</div>
</section>