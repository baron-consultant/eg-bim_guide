---
import { IMAGE_BASE_PATH } from "../../config";
---

<section id="group4" class="customize01">
  <!-- 타이틀 -->
  <div class="page-tit-wrap">
    <div class="tit-box">
      <h3>
        Configure the work environment and command <span>icon bar</span>&nbsp;as <span
          >the user desires</span
        >
      </h3>
    </div>
  </div>

  <!-- // 타이틀 -->
  <div class="contents">
    <div class="inner">
      <img
        class="bg-img"
        src={`${IMAGE_BASE_PATH}/en/customize/3x_customize_01.png`}
        alt=" "
      />
      <!-- 링크 -->
      <ul>
        <li>
          <a class="link-prfall" href="/eg-bim_guide/help/en/customize03">
            <span class="blind">Support View All</span>
            <div class="blind">
              Set auxiliary functions such as Grid and Object Snap (ON/OFF mode via toggle button)
            </div>
          </a>
        </li>

        <li>
          <a class="link-cmdall" href="/eg-bim_guide/help/en/command01">
            <span class="blind">Commands View All</span>
            <div class="blind">View all commands of EG-BIM</div>
          </a>
        </li>
        <li class="blind">
          <dl>
            <dt>Support Icon Bar</dt>
            <dd>
              Set auxiliary functions such as Grid and Object Snap (ON/OFF mode via icon color)
            </dd>
            <dd>Up to 6 commands can be registered (15 types provided in total)</dd>
            <dd>Right-click to delete icon</dd>

            <dt>Register Support Function Icon</dt>
            <dd>Drag & Drop to the Auxiliary Function Icon Bar</dd>

            <dt>Adjust Icon Bar Length</dt>

            <dt>Command Icon Bar</dt>
            <dd>Up to 16 icons can be registered per group</dd>
            <dd>Right-click to delete icon</dd>

            <dt>Default Group</dt>
            <dd>Only commands of the same group can be registered</dd>
            <dd>Cannot delete or rename</dd>

            <dt>Move Icon and Group</dt>
            <dd>Drag & Drop to desired location</dd>

            <dt>Register Command Icon</dt>
            <dd>When registering a command of the same group, register the representative icon</dd>
            <dd>Drag & Drop to the Command Icon Bar</dd>

            <dt>Add Command Icon</dt>
            <dd>View All Commands pop-up to add icons</dd>

            <dt>Create User Group</dt>
            <dd>Commands from all groups can be registered</dd>
            <dd>Right-click to delete or rename group</dd>

            <dt>Add Group</dt>
            <dd>Click to create a user group</dd>
          </dl>
        </li>
      </ul>
      <!-- // 링크 -->
    </div>
  </div>
</section>
