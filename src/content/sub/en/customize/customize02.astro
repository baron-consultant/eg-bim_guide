---
import { IMAGE_BASE_PATH } from "../../config";
---

<section id="group5" class="customize02">
  <!-- 타이틀 -->
  <div class="page-tit-wrap">
    <div class="tit-box">
      <span class="page-tail"></span>
      <h3>
        Configure&nbsp;<span>basic program</span>&nbsp;environment according to
        the user's work style
      </h3>
      <span class="page-tail"></span>
    </div>
    <div class="tip-box">
      <h4 class="tip-tit">How to use</h4>
      <dl>
        <dt>Method 1</dt>
        <dd>Command Input Window&nbsp;&nbsp;>&nbsp;&nbsp;Command : OPTIONS</dd>
      </dl>
      <dl>
        <dt>Method 2</dt>
        <dd>
          Home Menu&nbsp;&nbsp;>&nbsp;&nbsp;User
          Settings&nbsp;&nbsp;>&nbsp;&nbsp;Display&Mouse
        </dd>
      </dl>
    </div>
  </div>

  <!-- // 타이틀 -->
  <div class="contents">
    <div class="inner">
      <img
        class="bg-img"
        src={`${IMAGE_BASE_PATH}/en/customize/3x_customize_02.png`}
        alt=" "
      />
      <div class="blind">
        <dl>
          <dt>Workspace Display</dt>
        </dl>
        <dl>
          <dt>Customize Mouse Buttons</dt>
          <dd>Scroll Wheel : Set the amount of Zoom In/Out on the screen</dd>
          <dd>Click Wheel : Screen pan or apply Object Snap selection</dd>
          <dd>
            Left/Right Click : Select Default/Edit Menu or Repeat Last Command
            during object selection/command execution
          </dd>

          <dt>Paper Space</dt>
          <dd>Select whether to automatically create a viewport when creating a new Paper space (Layout)</dd>

          <dt>File Security & Storage</dt>
          <dd>Select drawing format and save version</dd>
          <dd>Proxy object notification and display settings</dd>

          <dt>Autosave & Backup</dt>
          <dd>
            Manage backups and temp files by specifying save intervals and paths
            in preparation for program crash
          </dd>

          <dt>File Closing Options</dt>
          <dd>Whether to activate option when closing window while multiple files are open</dd>
        </dl>
      </div>
    </div>
  </div>
</section>
