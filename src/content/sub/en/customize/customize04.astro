---
import { IMAGE_BASE_PATH } from '../../config';
---

<section id="group7" class="customize04">
<!-- 타이틀 -->
<div class="page-tit-wrap">
  <div class="tit-box">
    <span class="page-tail"></span>
    <h3>
      <span>Execute commands simply</span>&nbsp;by setting aliases or shortcut keys for each command
    </h3>
    <span class="page-tail"></span>
  </div>
  <div class="tip-box">
    <h4 class="tip-tit">How to use</h4>
    <dl>
      <dt>Method 1</dt>
      <dd>
        Command Icon Bar&nbsp;&nbsp;>&nbsp;&nbsp;Command
        View All&nbsp;&nbsp;>&nbsp;&nbsp;Shortcut
      </dd>
    </dl>
  </div>
</div>

<!-- // 타이틀 -->

<div class="contents">
  <div class="inner">
      <img class="bg-img" src={`${IMAGE_BASE_PATH}/en/customize/3x_customize_04.png`} alt=" " />
      <div class="blind">
        <dl>
          <dt>Search Command</dt>
          <dd>Search by English command or alias</dd>
 
          <dt>Select Command Group</dt>
 
          <dt>Select Command</dt>
 
          <dt>Alias</dt>
          <dd>Combinations of English/Numbers or English+Numbers available</dd>
          <dd>Specify up to 2 per command</dd>
          <dd>Right-click to remove alias</dd>
 
          <dt>Shortcut</dt>
          <dd>Set with Combination Keys (CTRL, ALT, SHIFT) + English or Numbers / Function Keys (F1~F12)</dd>
          <dd>Specify up to 1 per command</dd>
          <dd>Right-click to remove shortcut key</dd>
        </dl>
      </div>
  </div>
</div>
</section>
 