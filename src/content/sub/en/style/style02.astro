---
import { IMAGE_BASE_PATH } from "../../config";
---

<section id="group15" class="style02">
  <!-- 타이틀 -->
  <div class="page-tit-wrap">
    <div class="tit-box">
      <span class="page-tail"></span>
      <h3>
        <span>Create text styles</span>&nbsp;and&nbsp;<span
          >detailed settings&nbsp;</span
        > in your desired style
      </h3>
      <span class="page-tail"></span>
    </div>
    <div class="tip-box">
      <h4 class="tip-tit">How to use</h4>
      <dl>
        <dt>Method 1</dt>
        <dd>Command Input Window&nbsp;&nbsp;>&nbsp;&nbsp;Command : STYLE</dd>
      </dl>
      <dl>
        <dt>Method 2</dt>
        <dd>
          Command View All&nbsp;&nbsp;>&nbsp;&nbsp;
          <img
            src={`${IMAGE_BASE_PATH}/ico/ico_text.svg`}
            alt=""
          />&nbsp;&nbsp;Text Style&nbsp;&nbsp;>&nbsp;&nbsp;Text Style Manager
        </dd>
      </dl>
      <dl>
        <dt>Method 3</dt>
        <dd>
          Top Bar&nbsp;&nbsp;>&nbsp;&nbsp;Text
          Style&nbsp;&nbsp;>&nbsp;&nbsp;Advanced settings
        </dd>
      </dl>
    </div>
  </div>

  <!-- // 타이틀 -->
  <div class="contents">
    <div class="inner">
      <img
        class="bg-img"
        src={`${IMAGE_BASE_PATH}/en/style/3x_style_02.png`}
        alt=" "
      />
      <div class="blind">
        <dl>
          <dt>Dimension Style LIST</dt>
          <dd>Provides 2 basic styles (Standard, ISO-25)</dd>
          <dd>Right-click to remove dimension style</dd>

          <dt>Select Dimension Style</dt>

          <dt>Add Dimension Style</dt>

          <dt>Settings Preview</dt>
          <dd>Preview shapes according to setting value changes</dd>
          <dd>Can Zoom In, Zoom Out, and Pan with the mouse wheel</dd>

          <dt>Modify Dimension Style</dt>
          <dd>Edit &rarr; Quit/Apply</dd>

          <dt>Scale Settings</dt>
          <dd>
            Dimension Scale : Input scale value to adjust dimension shape size
          </dd>
          <dd>
            Overall Dimension : Adjust dimension shape size by applying the
            dimension scale value
          </dd>
          <dd>
            Layout Space : Determined based on the scale between Model Space and
            Layout Space
          </dd>
          <dd>
            Fit Viewport Scale : Can adjust scale for dimension shapes to fit
            the viewport
          </dd>
          <dd>
            Scale Factor : Input scale value to apply to the measured dimension
            value
          </dd>

          <dt>Dimension Style Detailed Settings</dt>
          <dd>
            Dimension Units : Detailed settings for primary and secondary
            dimension units, etc.
          </dd>
          <dd>
            Dimension Text : Detailed settings for dimension texts displayed on
            dimension shapes
          </dd>
          <dd>
            Dimension Shape : Detailed settings for dimension shapes such as
            arrowheads and dimension line lengths
          </dd>
        </dl>
      </div>
    </div>
  </div>
</section>
