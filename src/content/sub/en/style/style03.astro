---
import { IMAGE_BASE_PATH } from "../../config";
---

<section id="group16" class="style03">
  <!-- 타이틀 -->
  <div class="page-tit-wrap">
    <div class="tit-box">
      <span class="page-tail"></span>
      <h3>
        <span>Create</span>&nbsp;and&nbsp;<span>modify dimension styles</span
        >&nbsp;in your desired style
      </h3>
      <span class="page-tail"></span>
    </div>
    <div class="tip-box">
      <h4 class="tip-tit">How to use</h4>
      <dl>
        <dt>Method 1</dt>
        <dd>Command Input Window&nbsp;&nbsp;>&nbsp;&nbsp;Command : DIMSTYLE</dd>
      </dl>
      <dl>
        <dt>Method 2</dt>
        <dd>
          Command View
          All&nbsp;&nbsp;>&nbsp;&nbsp;Dimension&nbsp;&nbsp;>&nbsp;&nbsp;
          <img
            src={`${IMAGE_BASE_PATH}/ico/ico_size.svg`}
            alt=""
          />&nbsp;&nbsp;Create Dimension Style&nbsp;&nbsp;>&nbsp;&nbsp;Dim Style
          Manager
        </dd>
      </dl>
      <dl>
        <dt>Method 3</dt>
        <dd>
          Top Bar&nbsp;&nbsp;>&nbsp;&nbsp;Dimension
          Style&nbsp;&nbsp;>&nbsp;&nbsp;Advanced settings
        </dd>
      </dl>
    </div>
  </div>

  <!-- // 타이틀 -->
  <div class="contents">
    <div class="inner">
      <img
        class="bg-img"
        src={`${IMAGE_BASE_PATH}/en/style/3x_style_03.png`}
        alt=" "
      />
      <div class="blind">
        <dl>
          <dt>Text Style LIST</dt>
          <dd>Provides 2 basic fonts (Standard[Arial], Dotum[돋움])</dd>
          <dd>Right-click to remove text style</dd>

          <dt>Select Text Style</dt>

          <dt>Indicate Missing Fonts</dt>
          <dd>
            (!) Informs that the font is currently missing and will not display
            correctly on screen
          </dd>

          <dt>Add Text Style</dt>

          <dt>Input Text Style Values</dt>
          <dd>Display and modify text style name and font</dd>
          <dd>Can configure detailed text size settings</dd>

          <dt>Text Style Detailed Settings</dt>
          <dd>
            Alignment : Set height reference for texts with varying heights
          </dd>
          <dd>Text Style : Set slant and text thickness</dd>
          <dd>Text Scale : Adjust text shape scale to match the viewport</dd>
          <dd>Text Direction : Set the direction of the text</dd>
          <dd>
            Large Fonts : Supports characters widely used in Asia, activated
            when using .SHX fonts exclusive to CAD
          </dd>

          <dt>Modify Text Style</dt>
          <dd>Edit &rarr; Quit/Apply</dd>

          <dt>Search Font</dt>

          <dt>Select Font</dt>
          <dd>Select a font to apply to the currently selected style</dd>

          <dt>Fonts in Use</dt>
          <dd>Fonts registered in the Text Style LIST are marked with (●)</dd>

          <dt>Font Group</dt>
          <dd>Classified into 10 font groups</dd>
        </dl>
      </div>
    </div>
  </div>
</section>
