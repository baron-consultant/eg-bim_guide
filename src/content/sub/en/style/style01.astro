---
import { IMAGE_BASE_PATH } from "../../config";
---

<section id="group14" class="style01">
  <!-- 타이틀 -->
  <div class="page-tit-wrap">
    <div class="tit-box">
      <span class="page-tail"></span>
      <h3>
        <span>Create, modify,</span>&nbsp;and manage line styles as&nbsp;
        <span>user styles</span>
      </h3>
      <span class="page-tail"></span>
    </div>
    <div class="tip-box">
      <h4 class="tip-tit">How to use</h4>
      <dl>
        <dt>Method 1</dt>
        <dd>Command Input Window&nbsp;&nbsp;>&nbsp;&nbsp;Command : LINETYPE</dd>
      </dl>
      <dl>
        <dt>Method 2</dt>
        <dd>
          Command View
          All&nbsp;&nbsp;>&nbsp;&nbsp;Geometry&nbsp;&nbsp;>&nbsp;&nbsp;
          <img
            src={`${IMAGE_BASE_PATH}/ico/ico_line.svg`}
            alt=""
          />&nbsp;&nbsp;Line Style &nbsp;&nbsp;>&nbsp;&nbsp;Create and Modifies
          Linetypes
        </dd>
      </dl>
      <dl>
        <dt>Method 3</dt>
        <dd>
          Top Bar&nbsp;&nbsp;>&nbsp;&nbsp;Line
          Style&nbsp;&nbsp;>&nbsp;&nbsp;Advanced settings
        </dd>
      </dl>
    </div>
  </div>

  <!-- // 타이틀 -->
  <div class="contents">
    <img
      class="bg-img"
      src={`${IMAGE_BASE_PATH}/en/style/3x_style_01.png`}
      alt=" "
    />
    <div class="blind">
      <dl>
        <dt>Construction Line Styles</dt>
        <dd>
          Provides basic line shapes and standard line shapes classified into 5
          sectors
        </dd>

        <dt>Load LIN File</dt>

        <dt>Construction Line Styles Search Window</dt>

        <dt>Select Line Shape</dt>
        <dd>Double-click to select and add to the Line Style LIST</dd>

        <dt>Basic Information</dt>
        <dd>Basic properties that all objects have</dd>

        <dt>Add to Line Style LIST</dt>

        <dt>Line Style LIST</dt>
        <dd>Provides 3 basic line shapes (Continuous, CENTER, HIDDEN)</dd>
        <dd>Right-click to remove line style</dd>

        <dt>Select Line Style</dt>

        <dt>Input Line Shape Values</dt>

        <dt>Block Detailed Settings</dt>

        <dt>Text Detailed Settings</dt>

        <dt>Modify Line Style</dt>
        <dd>Edit &rarr; Quit/Apply</dd>

        <dt>Select Style</dt>
        <dd>
          Line Type : Select line shape as a combination of lines, text, and
          blocks
        </dd>
        <dd>
          Block : Activated if a block is included in the selected line shape
        </dd>
        <dd>
          Text Style : Activated if text is included in the selected line shape,
          loads text styles currently used in the file
        </dd>
      </dl>
    </div>
  </div>
</section>
