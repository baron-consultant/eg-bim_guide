---
import { getSidebarTabs } from '../lib/sidebarConfig';
import SearchBar from './SearchBar.astro';

const {activeMenu } = Astro.props;

const locale = Astro.url.pathname.includes('/help/en/') ? 'en' : 'ko';
const sidebarTabs = await getSidebarTabs(locale);

const cleanActiveMenu = activeMenu ? activeMenu.replace(/^(en|ko)\//, '') : '';

function isItemActive(item: any): boolean {
  if (!item) return false;
  if (item.id === activeMenu || item.id === cleanActiveMenu) return true;
  if (item.href) {
    const hrefPath = item.href.replace(/\/$/, '');
    const hrefSlug = hrefPath.substring(hrefPath.lastIndexOf('/') + 1);
    if (hrefSlug && (hrefSlug === cleanActiveMenu || hrefSlug === activeMenu)) {
      return true;
    }
  }
  if (item.children && item.children.length > 0) {
    return item.children.some((child: any) => isItemActive(child));
  }
  return false;
}

// 현재 활성 탭 결정 (activeMenu가 속한 탭)
function getActiveTab() {
  // 1️⃣ activeMenu 기반으로 탭 찾기
  for (const tab of sidebarTabs) {
    for (const group of tab.groups) {
      for (const item of group.items) {
        if (isItemActive(item)) return tab.id;
      }
    }
  }
  
  // 2️⃣ Astro.url을 사용하여 서버/클라이언트 모두에서 URL 기반 탭 결정
  const currentPath = Astro.url.pathname;
  if (currentPath.includes('/ko/commands/') || currentPath.includes('/en/commands/')) {
    return 'commands';
  }
  
  // 3️⃣ activeMenu 문자열로 판단
  if (activeMenu && activeMenu.includes('commands')) {
    return 'commands';
  }
  
  return sidebarTabs[0]?.id || 'grimmi';
}

const activeTab = getActiveTab();

// 각 탭의 첫 번째 링크 찾기 함수
function getFirstLinkForTab(tab: any): string {
  for (const group of tab.groups) {
    for (const item of group.items) {
      // 직접 링크가 있는 경우
      if (item.href) return item.href;
      
      // 자식이 있는 경우 첫 번째 자식의 링크
      if (item.children && item.children.length > 0) {
        const firstChild = item.children[0];
        if (firstChild.href) return firstChild.href;
        
        // 손자가 있는 경우
        if (firstChild.children && firstChild.children.length > 0) {
          return firstChild.children[0].href;
        }
      }
    }
  }
  return '#';
}
---

<!-- 탭 메뉴 -->
<div class="sidebar-wrap">
    <div class="searchbar-wrapper" >
      <SearchBar />
    </div>
    <div class="sidebar-tabs">
      <span class="tab-btn-bg"></span>
      {sidebarTabs.map(tab => (
        <button 
          class={`tab-button ${activeTab === tab.id ? 'active' : ''}`}
          data-tab={tab.id}
          data-tab-link={getFirstLinkForTab(tab)}
        >
          {tab.icon && <i class={tab.icon}></i>}
          <span>{tab.label}</span>
        </button>
      ))}
    </div>
  
  </div>
<div class="lnb-container">
  <!-- 탭 컨텐츠 -->
  {sidebarTabs.map(tab => (
    <div 
      class={`tab-content ${activeTab === tab.id ? 'active' : ''} ${tab.id === 'commands' ? 'grid-layout' : ''}`}
      data-tab-content={tab.id}
    >
      {tab.groups.map((group, groupIdx) => (
        <div class="nav-group">
          <div class="group-tit">
            <h2><i class={group.icon}></i>{group.title}</h2>
          </div>

          <ul class="depth01">
            {group.items.map((item, idx) => {
              const menuId = `${tab.id}_menuGroup${String(groupIdx * 10 + idx + 1).padStart(2, '0')}`;
              
              // 🔹 라벨이 없으면 single로 처리
              const isSingleItem = item.children && !item.label;
              
              return (
                <li class={isItemActive(item) ? 'active' : ''}>
                  {item.children ? (
                    <>
                      {/* 🔹 single인 경우 depth01 > li > a 없이 바로 depth02 */}
                      {!isSingleItem && (
                        <a href="#" data-toggle={menuId}>
                          <i class="ico-arrow"></i>
                          <span>{item.label}</span>
                        </a>
                      )}
                      
                      <ul class={`depth02 ${isSingleItem ? 'single' : (isItemActive(item) ? '' : 'd-none')}`} id={menuId}>
                        {item.children.map((child) => (
                          <li class={isItemActive(child) ? 'active' : ''}>
                            <a href={child.href || '#'} data-page={child.id} data-astro-prefetch="hover">
                              {child.children && (
                                <i class="ico-line"></i>
                              )} 
                              <span>{child.label}</span>
                            </a>
                            
                            {child.children && (
                              <ul class="depth03">
                                {child.children.map((grandChild) => (
                                  <li class={isItemActive(grandChild) ? 'active' : ''}>
                                    <a href={grandChild.href} data-page={grandChild.id} data-astro-prefetch="hover">
                                      <span>{grandChild.label}</span>
                                    </a>
                                  </li>
                                ))}
                              </ul>
                            )}
                          </li>
                        ))}
                      </ul>
                    </>
                  ) : (
                    <ul class="depth02 single">
                      <li class={isItemActive(item) ? 'active' : ''}>
                        <a href={item.href} data-page={item.id} data-astro-prefetch="hover">
                          <span>{item.label}</span>
                        </a>
                      </li>
                    </ul>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  ))}
</div>
<script>
import { navigate } from 'astro:transitions/client';

/* ------------------------------
  사이드바 스크롤 상태 저장
------------------------------ */
function saveSidebarScroll() {
  const sidebar = document.querySelector('.nav-wrap');
  if (!sidebar) return;

  const activeTabBtn = document.querySelector('.sidebar-tabs .tab-button.active');
  const tabId = activeTabBtn?.dataset.tab || 'default';

  sessionStorage.setItem(`scroll_${tabId}`, sidebar.scrollTop);
}

/* ------------------------------
  사이드바 스크롤 복원
------------------------------ */
function restoreSidebarScroll() {
  const sidebar = document.querySelector('.nav-wrap');
  if (!sidebar) return;

  const activeTabBtn = document.querySelector('.sidebar-tabs .tab-button.active');
  const tabId = activeTabBtn?.dataset.tab || 'default';

  const savedScroll = sessionStorage.getItem(`scroll_${tabId}`);
  if (savedScroll) {
    sidebar.scrollTop = parseFloat(savedScroll);
  }
}

/* ------------------------------
  메뉴 열림 상태 저장 (grimmi 탭용)
------------------------------ */
function saveMenuState() {
  const activeTabBtn = document.querySelector('.sidebar-tabs .tab-button.active');
  const tabId = activeTabBtn?.dataset.tab;
  
  // grimmi 탭만 상태 저장
  if (tabId === 'grimmi') {
    const openMenus = [];
    document.querySelectorAll('.tab-content.active .depth01 > li.active').forEach(li => {
      const toggleLink = li.querySelector('a[data-toggle]');
      if (toggleLink) {
        const toggleId = toggleLink.getAttribute('data-toggle');
        if (toggleId) openMenus.push(toggleId);
      }
    });
    sessionStorage.setItem(`menuState_${tabId}`, JSON.stringify(openMenus));
  }
}

/* ------------------------------
  메뉴 열림 상태 복원 (grimmi 탭용)
------------------------------ */
function restoreMenuState() {
  const activeTabBtn = document.querySelector('.sidebar-tabs .tab-button.active');
  const tabId = activeTabBtn?.dataset.tab;
  
  // grimmi 탭만 상태 복원
  if (tabId === 'grimmi') {
    const currentPath = window.location.pathname;
    const activeItem = document.querySelector('.tab-content.active a[data-page].active, .tab-content.active .depth02 > li.active > a');
    
    // 현재 활성화된 아이템의 부모 그룹
    const activeParentGroup = activeItem?.closest('.depth01 > li');

    // 현재 선택된 메뉴의 부모 그룹이 아니면 다른 depth01 > li의 active 제거 및 depth02 닫아두기
    document.querySelectorAll('.tab-content.active .depth01 > li').forEach(parentLi => {
      if (parentLi !== activeParentGroup) {
        parentLi.classList.remove('active');
        const depth02 = parentLi.querySelector('.depth02:not(.single)');
        if (depth02) {
          depth02.classList.add('d-none');
        }
      }
    });

    const savedState = sessionStorage.getItem(`menuState_${tabId}`);
    if (savedState) {
      try {
        const openMenus = JSON.parse(savedState);
        openMenus.forEach(toggleId => {
          const depth02 = document.getElementById(toggleId);
          const parentLi = depth02?.closest('.depth01 > li');
          // activeParentGroup이거나 사용자가 직접 조작한 메뉴인 경우만 복원
          if (depth02 && parentLi && !depth02.classList.contains('single') && parentLi === activeParentGroup) {
            depth02.classList.remove('d-none');
            parentLi.classList.add('active');
          }
        });
      } catch (e) {
        console.warn('Failed to restore menu state:', e);
      }
    }
  }
}

/* ------------------------------
  중앙으로 스크롤시켜주는 함수
------------------------------ */
function scrollActiveDepth02IntoView() {
  const sidebar = document.querySelector('.nav-wrap');
  if (!sidebar) return;

  const activeItem = sidebar.querySelector('.depth02 > li.active, .depth03 > li.active');
  if (!activeItem) return;

  const sidebarRect = sidebar.getBoundingClientRect();
  const itemRect = activeItem.getBoundingClientRect();
  const visibleHeight = sidebar.clientHeight;

  const targetScroll =
    activeItem.offsetTop - visibleHeight / 2 + activeItem.offsetHeight / 2;

  const thresholdBottom = sidebarRect.bottom - 160;
  const thresholdTop = sidebarRect.top + 280;
  
  if (itemRect.top < thresholdTop || itemRect.bottom > thresholdBottom) {
    sidebar.scrollTo({
      top: targetScroll,
      behavior: 'smooth',
    });
  }
}

/* ------------------------------
  사이드바 초기화 함수
------------------------------ */
/* ------------------------------
  사이드바 초기화 함수
------------------------------ */
function initializeSidebar() {
  const tabButtons = document.querySelectorAll('.sidebar-tabs .tab-button'); 
  const tabContents = document.querySelectorAll('.tab-content');

  let isNavigating = false;

  const $ = (s: string) => document.querySelector(s);
  const $$ = (s: string) => [...document.querySelectorAll(s)];

  function isCommandsTab() {
    const activeTabContent = $('.tab-content.active');
    return activeTabContent?.classList.contains('grid-layout');
  }

  function setInitialTab() {
    const path = window.location.pathname;
    let activeTabId = (path.includes('/ko/commands/') || path.includes('/en/commands/')) ? 'commands' : tabButtons[0]?.getAttribute('data-tab') || 'grimmi';
    activateTab(activeTabId);
  }
  
  function activateTab(tabId: string) {
    saveMenuState();
    saveSidebarScroll();

    tabButtons.forEach(btn => btn.classList.toggle('active', btn.getAttribute('data-tab') === tabId));
    tabContents.forEach(content => content.classList.toggle('active', content.getAttribute('data-tab-content') === tabId));

    requestAnimationFrame(() => {
      restoreMenuState();
      restoreSidebarScroll();
    });
  }

  /* ------------------------------
    탭 버튼 클릭 처리
  ------------------------------ */
  tabButtons.forEach(btn => {
    if ((btn as any).dataset.bound) return;
    (btn as any).dataset.bound = 'true';

    btn.addEventListener('click', function(this: HTMLElement) {
      if (isNavigating || this.classList.contains('active')) return;

      const tabId = this.getAttribute('data-tab') || 'grimmi';
      const defaultLink = this.getAttribute('data-tab-link') || '#';
      const lastVisited = sessionStorage.getItem(`lastVisited_${tabId}`) || defaultLink;

      activateTab(tabId);

      isNavigating = true;
      requestAnimationFrame(() => {
        navigate(lastVisited).finally(() => isNavigating = false);
      });
    });
  });

  /* ------------------------------
    depth 메뉴 토글
  ------------------------------ */
  $$('.depth01 > li > a[data-toggle]').forEach(menu => {
    if ((menu as any).dataset.bound) return;
    (menu as any).dataset.bound = 'true';

    menu.addEventListener('click', function(this: HTMLElement, e: Event) {
      e.preventDefault();
      const parentLi = this.parentElement;
      const toggleId = this.getAttribute('data-toggle');
      const depth02 = toggleId ? document.getElementById(toggleId) : null;

      if (depth02 && !depth02.classList.contains('single')) {
        const isCommands = isCommandsTab();

        if (isCommands) {
          const isCurrentlyOpen = parentLi?.classList.contains('active') && !depth02.classList.contains('d-none');
          if (isCurrentlyOpen) {
            parentLi?.classList.remove('active');
            depth02.classList.add('d-none');
          } else {
            $$('.depth01 > li').forEach(li => li.classList.remove('active'));
            $$('.depth02:not(.single)').forEach(depth => depth.classList.add('d-none'));
            parentLi?.classList.add('active');
            depth02.classList.remove('d-none');
          }
        } else {
          depth02.classList.toggle('d-none');
          parentLi?.classList.toggle('active');
          saveMenuState();
        }
      }
    });
  });

  /* ------------------------------
    링크 클릭 시 즉각적인 시각 피드백 & lastVisited 저장
  ------------------------------ */
  $$('.depth02 a, .depth03 a').forEach(link => {
    if ((link as any).dataset.bound) return;
    (link as any).dataset.bound = 'true';

    link.addEventListener('click', function(this: HTMLElement) {
      const href = this.getAttribute('href');
      if (!href || href === '#') return;

      // ⚡️ [즉각적 반응] 클릭하는 순간 0.001초 만에 즉시 메뉴 선택 강조!
      $$('.depth02 li, .depth03 li').forEach(li => li.classList.remove('active'));
      const targetLi = this.closest('li');
      targetLi?.classList.add('active');

      const parentDepth01Li = this.closest('.depth01 > li');
      $$('.depth01 > li').forEach(li => {
        if (li !== parentDepth01Li) {
          li.classList.remove('active');
        }
      });
      parentDepth01Li?.classList.add('active');

      saveSidebarScroll();
      saveMenuState();

      const activeTabBtn = document.querySelector('.sidebar-tabs .tab-button.active') as HTMLElement;
      if (activeTabBtn) {
        const tabId = activeTabBtn.getAttribute('data-tab');
        sessionStorage.setItem(
          `lastVisited_${tabId}`,
          new URL(href, location.origin).pathname
        );
      }
    });
  });

  setInitialTab();
}

initializeSidebar();

document.addEventListener('astro:page-load', () => {
  initializeSidebar();
  restoreMenuState();          // 메뉴 상태 복원
  restoreSidebarScroll();      // 이전 스크롤 위치 복원
  setTimeout(() => {
    scrollActiveDepth02IntoView(); // 선택된 메뉴 중앙 배치
  }, 50);
});

/* ------------------------------
  🔙 뒤로가기(popstate) 처리
------------------------------ */
window.addEventListener('popstate', () => {
  const currentPath = window.location.pathname;
  const activeTabContent = document.querySelector('.tab-content.active');
  const isCommands = activeTabContent?.classList.contains('grid-layout');

  // 🔹 스크롤 복원
  restoreSidebarScroll();

  // 🔹 grimmi 탭이면 저장된 메뉴 상태 먼저 복원
  if (!isCommands) {
    restoreMenuState();
  }

  // 🔹 현재 메뉴 찾기
  const currentAnchor = [...document.querySelectorAll('a[href]')].find(a =>
    new URL(a.href, location.origin).pathname === currentPath
  );
  if (!currentAnchor) return;

  // 🔹 활성 표시 초기화
  document.querySelectorAll('.depth02 li, .depth03 li').forEach(li => li.classList.remove('active'));

  // 🔹 commands 탭일 경우에만 모든 메뉴 닫기
  if (isCommands) {
    document.querySelectorAll('.depth01 > li.active').forEach(li => li.classList.remove('active'));
    document.querySelectorAll('.depth02:not(.single)').forEach(ul => ul.classList.add('d-none'));
  }

  // 🔹 현재 메뉴만 열기
  const parentLi = currentAnchor.closest('.depth01 > li');
  const parentDepth02 = currentAnchor.closest('.depth02');

  parentLi?.classList.add('active');
  if (parentDepth02 && !parentDepth02.classList.contains('single')) {
    parentDepth02.classList.remove('d-none');
  }

  currentAnchor.parentElement?.classList.add('active');

  // 🔹 활성 메뉴 중앙 배치
  setTimeout(scrollActiveDepth02IntoView, 400);
});
</script>